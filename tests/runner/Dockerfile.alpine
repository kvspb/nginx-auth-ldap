# Test runner on Alpine Linux: musl libc and Alpine's OpenLDAP and OpenSSL.
# Same entry point as the Debian runner (Dockerfile); no coverage tools and
# no AddressSanitizer, which musl does not support.
FROM alpine:3.22

RUN apk add --no-cache \
        build-base \
        curl \
        linux-headers \
        openldap-clients \
        openldap-dev \
        openssl \
        openssl-dev \
        pcre2-dev \
        py3-pytest \
        py3-requests \
        python3 \
        zlib-dev

ENV PYTHONDONTWRITEBYTECODE=1

COPY run-tests.sh /usr/local/bin/run-tests

ENTRYPOINT ["/bin/sh", "/usr/local/bin/run-tests"]

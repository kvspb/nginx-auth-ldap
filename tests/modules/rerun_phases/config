# Test-only module, built by tests/runner/run-tests.sh and
# tests/mutation/run-mutation.sh; never part of a release build.
ngx_addon_name=ngx_http_test_rerun_phases_module

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_test_rerun_phases_module
    ngx_module_srcs="$ngx_addon_dir/ngx_http_test_rerun_phases_module.c"
    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES ngx_http_test_rerun_phases_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/ngx_http_test_rerun_phases_module.c"
fi
